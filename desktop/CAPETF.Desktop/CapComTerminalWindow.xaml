<Window x:Class="CAPETF.Desktop.CapComTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cap.com Terminal"
        Width="1540"
        Height="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#050914">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1F2A3D"/>
        <SolidColorBrush x:Key="InkBrush" Color="#E5EDF7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A4BA"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#111C2E"/>
            <Setter Property="BorderBrush" Value="#26364F"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#08111F"/>
            <Setter Property="BorderBrush" Value="#26364F"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="cap.com Terminal" Foreground="{StaticResource InkBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock x:Name="ConnectionText" Text="saved keys required" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="180" Text="" ToolTip="Capital.com search text. Blank loads the default stock set." Margin="0,0,8,0"/>
                    <Button Content="Connect" Click="Connect_Click"/>
                    <Button Content="Load Stocks" Click="LoadStocks_Click"/>
                    <Button Content="Build Synthetic" Click="BuildSynthetic_Click" Background="#1D4ED8" BorderBrush="#60A5FA"/>
                    <Button Content="Stream" Click="StreamSynthetic_Click" Background="#216E8A" BorderBrush="#38BDF8"/>
                </WrapPanel>
                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="BlockBox"/>
                    <ComboBox x:Name="ResolutionBox">
                        <ComboBoxItem Content="Weekly" IsSelected="True"/>
                        <ComboBoxItem Content="Daily"/>
                        <ComboBoxItem Content="6H"/>
                        <ComboBoxItem Content="4H"/>
                        <ComboBoxItem Content="2H"/>
                    </ComboBox>
                    <ComboBox x:Name="CandleTypeBox" SelectionChanged="CandleType_SelectionChanged">
                        <ComboBoxItem Content="Candles" IsSelected="True"/>
                        <ComboBoxItem Content="Heikin Ashi"/>
                    </ComboBox>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="332"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#050914">
                <Grid x:Name="StockSharpChartHost" Background="#050914"/>
                <Canvas x:Name="NativeCandleCanvas" IsHitTestVisible="False" Margin="12,10,78,42"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#AA050914" BorderBrush="#26364F" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="SymbolText" Text="No synthetic symbol" Foreground="{StaticResource InkBrush}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ChartMetaText" Text="Load stocks and build a synthetic chart." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="SYNTHETIC FORMULA" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SyntheticFormulaText" Text="No formula yet." Foreground="{StaticResource InkBrush}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="ORDER PREVIEW" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Quantity multiplier" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
                        <TextBox x:Name="QuantityBox" Text="1"/>
                        <UniformGrid Columns="2" Margin="0,10,0,8">
                            <Button Content="Buy" Click="BuyPreview_Click" Background="#14532D" BorderBrush="#22C55E"/>
                            <Button Content="Sell" Click="SellPreview_Click" Background="#7F1D1D" BorderBrush="#EF4444" Margin="8,0,0,0"/>
                        </UniformGrid>
                        <TextBlock x:Name="OrderPreviewText" Text="Preview only. No live orders are sent." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ComponentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Epic}" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Foreground="{StaticResource InkBrush}">
                                                <Run Text="{Binding Weight, StringFormat={}{0:0.00}%}"/>
                                                <Run Text="  last "/>
                                                <Run Text="{Binding Last, TargetNullValue=n/a}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</Window>
