<Window x:Class="CAPETF.Desktop.CapComTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="cap.com Terminal"
        Width="1540"
        Height="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#050914">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1F2A3D"/>
        <SolidColorBrush x:Key="InkBrush" Color="#E5EDF7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A4BA"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#111C2E"/>
            <Setter Property="BorderBrush" Value="#26364F"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#08111F"/>
            <Setter Property="BorderBrush" Value="#26364F"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="cap.com Terminal" Foreground="{StaticResource InkBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,0,14,0"/>
                        <TextBlock x:Name="ConnectionText" Text="saved keys required" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="Fit" Click="FitChart_Click"/>
                        <Button Content="Live" Click="GoToRealtime_Click"/>
                        <Button Content="Zoom +" Click="ZoomIn_Click"/>
                        <Button Content="Zoom -" Click="ZoomOut_Click"/>
                        <Button Content="Left" Click="PanLeft_Click"/>
                        <Button Content="Right" Click="PanRight_Click"/>
                        <Button Content="Reset" Click="ResetChart_Click"/>
                        <Button Content="Legs / Formula" Click="ToggleTicket_Click"/>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,7,0,0" VerticalAlignment="Center">
                    <ComboBox x:Name="BlockBox" MinWidth="190" SelectionChanged="BlockBox_SelectionChanged"/>
                    <ComboBox x:Name="SearchBox" AutomationProperties.Name="Seed symbol" Width="230" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" ToolTip="Choose a symbol from the selected block, or type one." Margin="0,0,6,0"/>
                    <Button Content="Connect" Click="Connect_Click"/>
                    <ComboBox x:Name="StrategyBox" MinWidth="170" ToolTip="Choose how the synthetic basket should be selected."/>
                    <Button Content="Build Basket" Click="BuildSynthetic_Click" Background="#1D4ED8" BorderBrush="#60A5FA"/>
                    <Button Content="Save Basket" Click="SaveBasket_Click"/>
                    <ComboBox x:Name="SavedBasketsBox" MinWidth="190" SelectionChanged="SavedBaskets_SelectionChanged" ToolTip="Reload a saved synthetic basket."/>
                    <ComboBox x:Name="ResolutionBox" SelectionChanged="Resolution_SelectionChanged">
                        <ComboBoxItem Content="Weekly" IsSelected="True"/>
                        <ComboBoxItem Content="Daily"/>
                        <ComboBoxItem Content="6H"/>
                        <ComboBoxItem Content="4H"/>
                        <ComboBoxItem Content="2H"/>
                    </ComboBox>
                    <ComboBox x:Name="CandleTypeBox" SelectionChanged="CandleType_SelectionChanged">
                        <ComboBoxItem Content="Candles" IsSelected="True"/>
                        <ComboBoxItem Content="Heikin Ashi"/>
                    </ComboBox>
                    <CheckBox x:Name="TerminalMa20Check" Content="MA20" IsChecked="True" Checked="Ma_Changed" Unchecked="Ma_Changed"/>
                    <CheckBox x:Name="TerminalMa50Check" Content="MA50" IsChecked="True" Checked="Ma_Changed" Unchecked="Ma_Changed"/>
                    <CheckBox x:Name="TerminalMa200Check" Content="MA200" IsChecked="True" Checked="Ma_Changed" Unchecked="Ma_Changed"/>
                    <CheckBox x:Name="PriceLinesCheck" Content="Bid/Ask lines" IsChecked="True" Checked="PriceLines_Changed" Unchecked="PriceLines_Changed"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#050914">
            <wv2:WebView2 x:Name="TerminalWebView" DefaultBackgroundColor="#050914"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="#B0050914" BorderBrush="#26364F" BorderThickness="1" Padding="10,7">
                <StackPanel>
                    <TextBlock x:Name="SymbolText" Text="No synthetic symbol" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ChartMetaText" Text="Load stocks and build a synthetic chart." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="SyntheticFormulaText" Text="No formula yet."/>
                    <TextBox x:Name="QuantityBox" Text="1"/>
                    <TextBlock x:Name="OrderPreviewText" Text="Preview only. No live orders are sent."/>
                    <Button Content="Buy" Click="BuyPreview_Click"/>
                    <Button Content="Sell" Click="SellPreview_Click"/>
                    <ItemsControl x:Name="ComponentsList"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
